# Copy this file to .env and adjust if needed. No secrets are required for the
# default local setup.
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://localhost:11434

# qwen3 "thinking" mode: false = faster answers, true = more reasoning (slower)
OLLAMA_THINK=false
OLLAMA_TEMPERATURE=0.2
# Seconds to wait for Ollama (first request loads the model and can be slow)
OLLAMA_TIMEOUT=300

# Maximum rounds of tool calls per question (search -> compare -> ...)
MAX_TOOL_ROUNDS=5

# INFO shows the [USER]/[LLM]/[MCP]/[SERVER] flow, WARNING hides it
LOG_LEVEL=INFO
SERVER_LOG_LEVEL=INFO

# Web UI (python web_app.py). 127.0.0.1 = only this computer can open it.
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ---------------------------------------------------------------------------
# Data providers (comma-separated). The first one answers the tools; the rest
# report their status next to the results.
#   local    = products.json demo catalogue (default, no credentials)
#   amazon   = placeholder only: no live integration yet, returns no data
#   flipkart = placeholder only: no live integration yet, returns no data
# Example: SHOPPING_PROVIDERS=local,amazon,flipkart
SHOPPING_PROVIDERS=local

# Future Amazon India Creators API credentials (not used yet). Requires an
# approved Amazon.in Associates account with recent qualifying sales.
# Keep real values in .env only, never in .env.example or git.
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=
AMAZON_PARTNER_TAG=

# Future Flipkart Affiliate API credentials (not used yet).
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
